# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Client ID da aplicação (Discord Developer Portal > General Information)
CLIENT_ID=

# Client Secret (Discord Developer Portal > OAuth2 > General)
CLIENT_SECRET=

# IDs dos servidores onde os comandos devem ser registrados, separados por vírgula (opcional)
DEV_GUILD_IDS=

# URL de callback do OAuth2 (precisa bater com a cadastrada no Developer Portal)
REDIRECT_URI=

# Connection string do MongoDB Atlas
MONGODB_URI=

# Porta da API Express (opcional, padrão 3000)
PORT=

# Chave secreta usada pelo express-session para assinar os cookies de sessão
SESSION_SECRET=

# URL do frontend (dashboard), usada para liberar acesso via CORS
FRONTEND_URL=